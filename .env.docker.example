DJANGO_SECRET_KEY=CHANGE_ME
DJANGO_ALLOWED_HOSTS=CHANGE_ME
DJANGO_DB_NAME=CHANGE_ME
DJANGO_DB_USER=CHANGE_ME
DJANGO_DB_PASSWORD=CHANGE_ME
APP_PORT=8000
COMPLAINT_INTAKE_ENABLED=False
COMPLAINT_EMERGENCY_NOTICE=
ANONYMOUS_FEEDBACK_ENABLED=False
COMPLAINT_MAX_REOPENS=2

# Email: console is safe for local development. See docs/SMTP.md before enabling SMTP.
DJANGO_MAIL_BACKEND=console
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_SMTP_HOST=
# Blank selects 587 for STARTTLS or 465 for implicit TLS.
DJANGO_SMTP_PORT=
DJANGO_SMTP_USERNAME=
DJANGO_SMTP_PASSWORD=
DJANGO_SMTP_TIMEOUT=10
DJANGO_SMTP_USE_TLS=True
DJANGO_SMTP_USE_SSL=False
