DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_DB_ENGINE=sqlite
# DJANGO_DB_PATH=
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=5432

# Only the exact case-sensitive value True enables intake; true and 1 do not.
# Enable only after D01 approval, with the confirmed plain-text notice below.
COMPLAINT_INTAKE_ENABLED=False
COMPLAINT_EMERGENCY_NOTICE=
# Exact True only. Keep both off until D01 and deployment privacy checks pass.
ANONYMOUS_INTAKE_ENABLED=False
ANONYMOUS_PRIVACY_READY=False
# Anonymous release also requires an explicit HTTPS topology: direct or proxy.
# Leave blank for local HTTP development with anonymous intake disabled.
# proxy trusts X-Forwarded-Proto ONLY behind a verified, header-overwriting
# ingress with no direct backend access. See docs/B11_ANONYMOUS.md / #27 / #28.
DJANGO_HTTPS_MODE=
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Anonymous transport stays unavailable until E03/Q02 verify real TLS/proxy,
# Docker env forwarding, HSTS and blocked direct backend access. Exact True only.
ANONYMOUS_TRANSPORT_VERIFIED=False
# Start with an owner-approved HSTS duration; 0 keeps anonymous release blocked.
DJANGO_SECURE_HSTS_SECONDS=0
